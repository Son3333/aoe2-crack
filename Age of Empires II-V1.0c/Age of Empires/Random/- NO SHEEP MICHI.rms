/* ************************************ */
<PLAYER_SETUP>
 random_placement  
/* ************************************ */
<LAND_GENERATION>

start_random
  percent_chance 33
    #define FOREST_MAP
  percent_chance 33
    #define ALPINE_MAP
  percent_chance 34
    #define TROPICAL_MAP
end_random

if FOREST_MAP
  base_terrain FOREST
elseif ALPINE_MAP
  base_terrain PINE_FOREST
elseif TROPICAL_MAP
  base_terrain JUNGLE
endif

create_player_lands
{
     terrain_type GRASS
     land_percent 100
     base_size 9
     border_fuzziness  15
     set_zone_by_team
     other_zone_avoidance_distance 18
}

/* ************************************ */
<TERRAIN_GENERATION>



/* THINNING THE FOREST */

create_terrain LEAVES
