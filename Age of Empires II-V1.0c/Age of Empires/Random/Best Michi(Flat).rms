/*  FOREST  */

if FOREST_MAP
  create_terrain FOREST
elseif ALPINE_MAP
  create_terrain PINE_FOREST
elseif TROPICAL_MAP
  create_terrain JUNGLE
endif
{
  base_terrain                 GRASS
  land_percent                   20
  number_of_clumps               10
  set_avoid_player_start_areas     
  set_scale_by_groups
}

create_terrain GRASS2
{
  base_terrain                 SHALLOW
  land_percent                   20
  number_of_clumps               10
  set_scale_by_groups
}

if FOREST_MAP
  create_terrain FOREST
elseif ALPINE_MAP
  create_terrain PINE_FOREST
elseif TROPICAL_MAP
  create_terrain JUNGLE
endif
{
  base_terrain                 GRASS2
  spacing_to_other_terrain_types 0
  land_percent                   20
  number_of_clumps               10
  set_scale_by_groups
}


if FOREST_MAP
  create_terrain FOREST
elseif ALPINE_MAP
  create_terrain PINE_FOREST
elseif TROPICAL_MAP
