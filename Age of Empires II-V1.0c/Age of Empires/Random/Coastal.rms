/* ************************************* */

<CONNECTION_GENERATION>
create_connect_all_players_land
{
if FROZEN_MAP
  replace_terrain WATER         ICE
  replace_terrain MED_WATER     ICE
  replace_terrain DEEP_WATER    ICE
elseif MONGOLIAN_MAP
  replace_terrain WATER         ICE
  replace_terrain MED_WATER     ICE
  replace_terrain DEEP_WATER    ICE
else
  replace_terrain WATER         SHALLOW
  replace_terrain MED_WATER     SHALLOW
  replace_terrain DEEP_WATER    SHALLOW
endif
  terrain_cost    WATER         7
  terrain_cost    MED_WATER     9
  terrain_cost    DEEP_WATER    15
  terrain_cost    BEACH         7
  terrain_cost    SHALLOW       3
  terrain_cost    1_FOREST      7
  terrain_cost    2_FOREST      7
  terrain_cost    BASE_1        2
  terrain_cost    BASE_2        2
  terrain_cost    BASE_3        2
  terrain_cost    1_PATCH	  2
  terrain_cost    2_PATCH	  2
  terrain_cost    3_PATCH   	  2
    
  terrain_size    WATER         2       1
  terrain_size    MED_WATER     2       1
  terrain_size    DEEP_WATER    2       1  
  terrain_size    1_FOREST      0       0
  terrain_size    2_FOREST      0       0
  terrain_size    BASE_1        0       0
  terrain_size    BASE_2        0       0
  terrain_size    BASE_3        0       0
  terrain_size    1_PATCH       0       0
  terrain_size    2_PATCH       0       0
  terrain_size    3_PATCH       0       0
}
